<!doctype html>
<html lang="{{lang}}">
<head>
<meta charset="utf-8">
<title>{{appName}} — {{t.weeklyReport}} {{weekLabel}}</title>
<style>
{{{fontFace}}}

/* A4, zero page margin: Chromium paints page margins WHITE, so we keep the whole sheet yellow and
   make our own top/bottom breathing room with the repeating spacer rows of the .pg table below. */
@page { size: A4; margin: 0; }

* { box-sizing: border-box; }
html, body { margin: 0; background: #FCF535; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
body {
  color: #0B0B08;
  font-family: 'Bricolage Grotesque', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 16px; line-height: 1.3; font-weight: 500;
  font-optical-sizing: auto;
}

/* ---------- Header band (page 1) ---------- */
.head {
  background: #0B0B08; color: #FCF535;
  padding: 44px 48px 40px;
  display: flex; align-items: center; justify-content: space-between; gap: 24px;
  min-height: 300px;
}
.wordmark { font-size: 44px; font-weight: 800; letter-spacing: -0.05em; line-height: 1; }
.eyebrow  { margin-top: 44px; font-size: 14px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #D8D22C; }
.week     { margin-top: 8px; font-size: 50px; white-space: nowrap; font-weight: 800; letter-spacing: -0.05em; line-height: 0.95; }
.summary  { margin-top: 16px; font-size: 18px; font-weight: 500; }

/* the brand "moon": soft-edged yellow circle, same gradient as the app */
.moon {
  flex: 0 0 auto; width: 250px; height: 250px; border-radius: 50%;
  background: radial-gradient(closest-side, #FCF535 0%, #FCF535 74%, rgba(252,245,53,.55) 89%, rgba(252,245,53,0) 100%);
  display: flex; flex-direction: column; align-items: center; justify-content: center; color: #0B0B08;
}
.moon b { font-size: 60px; font-weight: 800; letter-spacing: -0.05em; line-height: .9; }
.moon span { margin-top: 6px; font-size: 16px; font-weight: 600; color: #55530F; }

/* ---------- Cards ---------- */
.pg { width: 100%; border-collapse: collapse; }
.pg > thead { display: table-header-group; }  /* repeats on every page: top spacer */
.pg > tfoot { display: table-footer-group; }  /* repeats on every page: bottom spacer */
.pg td { padding: 0; }
.sp { height: 36px; }
.wrap { padding: 0 48px; }
.grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: stretch; }

.card { display: flex; flex-direction: column; border: 2px solid #0B0B08; border-radius: 24px; overflow: hidden; break-inside: avoid; page-break-inside: avoid; }
.card-h { background: #0B0B08; color: #FCF535; padding: 16px 16px 16px; }
.card-h .row { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
.card-h h2 { margin: 0; font-size: 24px; font-weight: 800; letter-spacing: -0.05em; line-height: 1.05; overflow-wrap: anywhere; }
.card-h .count { font-size: 18px; font-weight: 700; white-space: nowrap; }
.bar { margin-top: 12px; height: 10px; border-radius: 999px; background: rgba(252,245,53,.25); overflow: hidden; }
.bar i { display: block; height: 100%; background: #FCF535; border-radius: 999px; }

.card-b { flex: 1; padding: 14px 16px 16px; }
.card-b h3 { margin: 0 0 8px; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #55530F; }
.card-b p + h3 { margin-top: 16px; }
.card-b ul + h3 { margin-top: 16px; }
.card-b ul { list-style: none; margin: 0; padding: 0; }
.card-b li { display: flex; align-items: flex-start; gap: 9px; padding: 3px 0; font-size: 16px; line-height: 1.25; }
.card-b li svg { flex: 0 0 auto; width: 20px; height: 20px; margin-top: 1px; }
.card-b li.ok   { color: #55530F; }
.card-b li.ok span { text-decoration: line-through; text-decoration-thickness: 1px; }
.card-b li.todo { color: #0B0B08; font-weight: 600; }
.empty { margin: 0; font-size: 16px; color: #55530F; }
.all   { margin: 0 0 14px; display: flex; align-items: center; gap: 9px; font-size: 16px; font-weight: 700; }
.all svg { width: 20px; height: 20px; }

/* ---------- Footer ---------- */
.foot { margin-top: 36px; padding-top: 18px; border-top: 2px solid #0B0B08; display: flex; align-items: baseline; justify-content: space-between; gap: 16px; font-size: 14px; color: #55530F; }
.foot .wm { font-size: 22px; font-weight: 800; letter-spacing: -0.05em; color: #0B0B08; }
</style>
</head>
<body>

<header class="head">
  <div>
    <div class="wordmark">{{appName}}</div>
    <div class="eyebrow">{{t.weeklyReport}}</div>
    <div class="week">{{weekLabel}}</div>
    <div class="summary">{{totals.summary}}</div>
  </div>
  <div class="moon" aria-label="{{totals.done}}/{{totals.total}} {{t.doneWord}}">
    <b>{{totals.done}}/{{totals.total}}</b>
    <span>{{t.doneWord}}</span>
  </div>
</header>

<table class="pg"><thead><tr><td class="sp"></td></tr></thead><tbody><tr><td>
<main class="wrap">
  <section class="grid">
    {{#each people}}
    <article class="card">
      <div class="card-h">
        <div class="row"><h2>{{name}}</h2><span class="count">{{done}}/{{total}}</span></div>
        <div class="bar"><i style="width: {{pct}}%"></i></div>
      </div>
      <div class="card-b">
        {{#if allDone}}
        <p class="all"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#0B0B08"/><path d="M6.5 12.8 L10.4 16.6 L17.6 8.2" fill="none" stroke="#FCF535" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>{{@root.t.allDone}}</p>
        {{/if}}

        <h3>{{@root.t.doneTitle}} &middot; {{done}}</h3>
        {{#if doneChores.length}}
        <ul>
          {{#each doneChores}}
          <li class="ok"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#0B0B08"/><path d="M6.5 12.8 L10.4 16.6 L17.6 8.2" fill="none" stroke="#FCF535" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{this}}</span></li>
          {{/each}}
        </ul>
        {{else}}
        <p class="empty">{{@root.t.nothingDone}}</p>
        {{/if}}

        {{#if missedChores.length}}
        <h3>{{@root.t.todoTitle}} &middot; {{missedChores.length}}</h3>
        <ul>
          {{#each missedChores}}
          <li class="todo"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="none" stroke="#0B0B08" stroke-width="2.4"/></svg><span>{{this}}</span></li>
          {{/each}}
        </ul>
        {{/if}}
      </div>
    </article>
    {{/each}}
  </section>

  <footer class="foot">
    <span class="wm">{{appName}}</span>
    <span>{{@root.t.generated}} &middot; {{@root.t.wipe}}</span>
  </footer>
</main>
</td></tr></tbody><tfoot><tr><td class="sp"></td></tr></tfoot></table>

</body>
</html>
